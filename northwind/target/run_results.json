antity*UnitPrice*(1-Discount)) as totalorderamount\n    from raw.northwind.Order_Details\n    group by orderid\n),\nstg_shippers as (\n    select * from raw.northwind.Shippers\n)\nselect  \n    o.*,\n    s.companyname as shippercompanyname,\n    od.quantityonorder, od.totalorderamount,\n    o.shippeddatekey - o.orderdatekey as daysfromordertoshipped,\n    o.requireddatekey - o.orderdatekey as daysfromordertorequired,\n    o.shippeddatekey - o.requireddatekey as shippedtorequireddelta,\n    case when o.shippeddatekey - o.requireddatekey <=0 then 'Y' else 'N' end as shippedontime\nfrom stg_orders o\n    join stg_order_details od on o.orderid = od.orderid\n    join stg_shippers s on s.shipperid = o.shipvia", "relation_name": "analytics.dbt_hkhan_northwind.fact_order_fulfillment", "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-03-01T09:04:29.693096Z", "completed_at": "2026-03-01T09:04:29.701530Z"}, {"name": "execute", "started_at": "2026-03-01T09:04:29.702416Z", "completed_at": "2026-03-01T09:04:29.891947Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.19969654083251953, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c2bbc0-0103-d030-0005-31e300038052"}, "message": null, "failures": 0, "unique_id": "test.northwind.unique_dim_customer_customerkey.183274e37c", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    customerkey as unique_field,\n    count(*) as n_records\n\nfrom analytics.dbt_hkhan_northwind.dim_customer\nwhere customerkey is not null\ngroup by customerkey\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-03-01T09:04:29.706119Z", "completed_at": "2026-03-01T09:04:29.712926Z"}, {"name": "execute", "started_at": "2026-03-01T09:04:29.713385Z", "completed_at": "2026-03-01T09:04:29.902173Z"}], "thread_id": "Thread-6 (worker)", "execution_time": 0.197